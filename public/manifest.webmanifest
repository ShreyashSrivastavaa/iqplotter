{
  "name": "iqplotter",
  "short_name": "iqplotter",
  "description": "Turn your CSV data into charts instantly. Free, private, in-browser.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FAF7E9",
  "theme_color": "#F26B21",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["productivity", "utilities"]
}
