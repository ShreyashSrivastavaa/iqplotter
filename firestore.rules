rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access to prevent unauthorized reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user profile & user data records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users access only to their own subcollections (e.g. saved charts/history)
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
